from collections import Counter
import re

def compare_labels(correct_list, checking_list):
    correct_counts = Counter(correct_list)
    checking_counts = Counter(checking_list)
    
    missing = []
    # Returns the label based on value of the labels
    for label in sorted(correct_counts.keys(), key=lambda x: int(x) if x.isdigit() else x):
        diff = correct_counts[label] - checking_counts[label]
        if diff > 0:
            missing.extend([str(label)] * diff)
            
    return missing

def read_rpc_format_file(filename):
    """Read another type of file, including num_num format"""
    encodings = ['utf-8', 'latin-1', 'cp1252']
    for enc in encodings:
        try:
            positions = []
            with open(filename, 'r', encoding=enc) as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    # match the format such as num_num，extract label in the front and back
                    match = re.search(r'(\d+)_(\d+)', line)
                    if match:
                        # If need the number after _ use: group(2)，before use: group(1)
                        positions.append(match.group(2))
            return positions
        except UnicodeDecodeError:
            continue
        except FileNotFoundError:
            return None
    return None

def read_normal_format_file(filename):
    """Read normal numbers or txt. files"""
    encodings = ['utf-8', 'latin-1', 'cp1252']
    for enc in encodings:
        try:
            positions = []
            with open(filename, 'r', encoding=enc) as f:
                for line in f:
                    line = line.strip()
                    if not line:
                        continue
                    tokens = line.replace(',', ' ').split()
                    for token in tokens:
                        if token.strip().isdigit():
                            positions.append(token.strip())
            return positions
        except UnicodeDecodeError:
            continue
        except FileNotFoundError:
            return None
    return None

